### BibleFlip behind nginx: replace example.com and the certificate paths ###

server {
	http2 on;
	listen 443 ssl;
	listen [::]:443 ssl;
	server_name example.com www.example.com;

	client_max_body_size 1M;

	### COMPRESSION ###
	# /api/verse-counts and /api/passage are JSON; audio arrives over the WebSocket
	gzip on;
	gzip_vary on;
	gzip_min_length 1024;
	gzip_proxied expired no-cache no-store private auth;
	gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml;
	gzip_disable "MSIE [1-6]\.";

	### SSL CONFIGURATION ###
	ssl_certificate						/etc/letsencrypt/live/example.com/fullchain.pem;
	ssl_certificate_key					/etc/letsencrypt/live/example.com/privkey.pem;
	ssl_session_cache					shared:SSL:5m;
	ssl_session_timeout					10m;
	ssl_protocols						TLSv1.2 TLSv1.3;
	ssl_ciphers						    HIGH:!aNULL:!MD5;
	ssl_prefer_server_ciphers 			on;

	### LOGGING INTERFACE ###
	access_log 	/var/log/nginx/bibleflip-access.log;
	error_log 	/var/log/nginx/bibleflip-error.log;

	#BibleFlip (container serves plain HTTP on 127.0.0.1:8094, see compose.yaml)
	location / {
		proxy_pass http://127.0.0.1:8094;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		# Microphone audio streams over a WebSocket (/ws) for the whole sermon
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_buffering off;
		proxy_read_timeout 86400s;
		proxy_send_timeout 86400s;
	}
}
